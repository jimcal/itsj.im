---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ExampleNote from '../../components/ExampleNote.astro';
import { getAbout } from '../../lib/content';
import { exampleDescription, exampleTitle, formatDate } from '../../lib/format';
import { blogPostingNode, graph, personNode } from '../../lib/jsonld';

export async function getStaticPaths() {
  const posts = await getCollection('writing', ({ data }) => {
    return import.meta.env.DEV || data.draft !== true;
  });
  return posts.map((post) => ({ params: { slug: post.id } }));
}

const slug = Astro.params.slug;
if (!slug) throw new Error('Missing post slug.');

const post = await getEntry('writing', slug);
if (!post) throw new Error(`Missing post: ${slug}`);

const about = await getAbout();
const { Content } = await render(post);
---

<Base
  title={exampleTitle(post.data.example, post.data.title)}
  description={exampleDescription(post.data.example, post.data.description)}
  ogType="article"
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt ?? post.data.publishedAt}
  jsonLd={graph([personNode(about), blogPostingNode(post, about)])}
>
  <article class="post">
    {post.data.example && <ExampleNote kind="post" />}
    <header class="post-header">
      <p class="kicker">Writing</p>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      <p class="meta">
        <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
        {
          post.data.updatedAt && (
            <>
              {' '}
              · Updated <time datetime={post.data.updatedAt.toISOString()}>{formatDate(post.data.updatedAt)}</time>
            </>
          )
        }
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
    <p class="back"><a href="/writing">All writing</a></p>
  </article>
</Base>
